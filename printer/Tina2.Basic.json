  "pre_gcode": [
    "M140 S{bed_temp}   ; p3d: need to heat the bed",
    "M190 S{bed_temp}   ; p3d: wait for bed temperature",
    ";(**** start.gcode for tina2****)",
    "M203 Z15",
    "M104 S{temp}",
    "G28 Z",
    "G28 X Y; Home extruder",
    "G1 X55 Y55 F1000",
    "G29",
    "M107 ; Turn off fan",
    "G90 ; Absolute positioning",
    "M82 ; Extruder in absolute mode",
    "M109 S{temp}      ; wait for extruder to reach target temp",
    "G92 E0 ; Reset extruder position",
    "G1 X90 Y6 Z0.27 F2000",
    "G1 X20 Y6 Z0.27 E15 F1000",
    "G92 E0 ; Reset extruder position",
    "M203 Z5"
  ],
  "post_gcode": [
    "M140 S0           ; p3d: cooldown bed",
    ";(**** end.gcode for tina2****)",
    "M203 Z15",
    "M104 S0",
    "M107",
    "G92 E0 (Reset after prime)",
    "G0 E-1 F300",
    "G28 Z F300",
    "G28 X0 Y0",
    "G1 Y90 F1000"
  ],
  "fan_gcode": "M106 S{fan_speed}",
  "progress_gcode": "M73 {progress}",

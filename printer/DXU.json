{
  "name": "DXU",
  "machine_name": "dxu",
  "source": "CuraV2",
  "license": "LGPL-3.0",
  "origin_center": false,
  "bed_elliptic": false,
  "bed_belt": false,
  "extruders": [
    {
      "nozzle": 0.4,
      "filament": 1.75,
      "offset_x": 0.0,
      "offset_y": 0.0,
      "select": "",
      "deselect": ""
    }
  ],
  "build_size": [
    238,
    223,
    203
  ],
  "pre_gcode": [
    "M104 S{temp}       ; p3d: need to heat the nozzle",
    "M109 S{temp}       ; p3d: wait for nozzle temperature",
    "\";material_bed_temperature={material_bed_temperature} material_print_temperature={material_print_temperature} material_print_temperature_layer_0={material_print_temperature_layer_0}",
    "M190 S{bed_temp}",
    "G21 ;metric values",
    "G90 ;absolute positioning",
    "M82 ;set extruder to absolute mode",
    "M107 ;start with the fan off",
    "; PLEASE CHECK: M200 D0 T{initial_extruder_nr} ;reset filament diameter",
    "G28 ;home all",
    "; PLEASE CHECK: T{initial_extruder_nr} ;switch to the first nozzle used for print",
    "; PLEASE CHECK: M104 T{initial_extruder_nr} S{material_standby_temperature, initial_extruder_nr}",
    "G0 X25 Y20 F7200",
    "G0 Z20 F2400",
    "; PLEASE CHECK: M109 T{initial_extruder_nr} S{material_print_temperature_layer_0, initial_extruder_nr}",
    "G0 X210 Y20 F7200",
    "G92 E-7.0",
    "G1 E0 F45 ;purge nozzle",
    "G1 E-6.5 F1500",
    "G1 E0 F1500",
    "M400 ;finish all moves",
    "; PLEASE CHECK: T{initial_extruder_nr}",
    ";end of startup sequence",
    "\""
  ],
  "post_gcode": [
    "\"G90 ;absolute positioning",
    "M104 S0 T0 ;extruder heater off",
    "M104 S0 T1",
    "M140 S0 ;turn off bed",
    "T0 ; move to the first head",
    "M107 ;fan off\""
  ],
  "fan_gcode": "M106 S{fan_speed}",
  "progress_gcode": "",
  "layer_gcode": "",
  "heated_bed": true,
  "speed_travel": 120.0
}
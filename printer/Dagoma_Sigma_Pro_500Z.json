{
  "name": "Dagoma Sigma Pro 500Z",
  "machine_name": "Dagoma Sigma Pro 500Z",
  "source": "CuraV2",
  "license": "LGPL-3.0",
  "origin_center": true,
  "bed_elliptic": true,
  "bed_belt": false,
  "extruders": [
    {
      "nozzle": 0.4,
      "filament": 1.75,
      "offset_x": 0.0,
      "offset_y": 0.0,
      "select": ";START T0\n;No temperature change\nG1 X0 Y77.5 F8000\nG92 E0\nM83\nG1 E50 F1200\nM82\nG92 E0\n",
      "deselect": ";END T0\nG92 E0\nM83\nG1 E-55 F4700\nM82\nG92 E0\n"
    }
  ],
  "build_size": [
    200,
    200,
    501
  ],
  "pre_gcode": [
    "M140 S{bed_temp}   ; need to heat the bed",
    "M190 S{bed_temp}   ; wait for bed temperature",
    "M104 S{temp}       ; need to heat the nozzle",
    "M109 S{temp}       ; wait for nozzle temperature",
    ";Start Gcode for {machine_name}",
    ";Author: Dagoma",
    ";Sliced: {date} {time}",
    ";Estimated print time: {print_time}",
    ";Print speed: {speed_print}mm/s",
    ";Layer height: {layer_height}mm",
    ";Wall thickness: {wall_thickness}mm",
    ";Infill density: {infill_sparse_density}%",
    ";Infill pattern: {infill_pattern}",
    ";Support: {support_enable}",
    ";Print temperature: {material_print_temperature}°C",
    ";Flow: {material_flow}%",
    ";Retraction amount: {retraction_amount}mm",
    ";Retraction speed: {retraction_retract_speed}mm/s",
    "G90 ;absolute positioning",
    "M190 S{bed_temp};",
    "M109 S140;",
    "G1 F200 E-1.0",
    "M106 S255 ;Activating layers fans",
    "G28 ;Homing",
    "G29 ;Calibration",
    "M107 ;Off Ventilateur",
    "M109 S{temp} ;Temperature for the first layer only",
    "G92 E0 ;Zero the extruded length again",
    "G1 X0 Y-105 Z1 F3000",
    "G1 F120",
    "M117 Printing...",
    ""
  ],
  "post_gcode": [
    ";End Gcode for {machine_name}",
    ";Author: Dagoma",
    "M104 S0",
    "M107 ;stop fan",
    "M140 S0 ;heated bed heater off (if you have it)",
    "G92 E0",
    "G1 E-55 F4600",
    "G27",
    "G90 ; Absolute positioning",
    "T0"
  ],
  "fan_gcode": "M106 S{fan_speed}",
  "progress_gcode": "",
  "layer_gcode": "",
  "heated_bed": true,
  "speed_travel": 120.0
}
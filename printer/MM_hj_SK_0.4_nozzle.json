{
  "name": "MM hj SK 0.4 nozzle",
  "machine_name": "MM hj SK 0.4 nozzle",
  "source": "OrcaSlicerV1",
  "license": "AGPL-3.0",
  "origin_center": false,
  "bed_elliptic": false,
  "bed_belt": false,
  "extruders": [
    {
      "nozzle": 0.4,
      "filament": 1.75,
      "offset_x": 0.0,
      "offset_y": 0.0,
      "select": "",
      "deselect": ""
    }
  ],
  "build_size": [
    220,
    210,
    300
  ],
  "pre_gcode": [
    "G0 Z3 F300",
    "G90 ;absolute positioning",
    ";GZBC",
    ";G28 ;Home",
    "M190 S{bed_temp}",
    "M104 S{temp}",
    ";BED_MESH_CLEAR ;touch",
    ";BLTOUCH_DEBUG COMMAND=reset ;touch",
    ";BED_MESH_CALIBRATE ;touch",
    ";BED_MESH_CALIBRATE METHOD=scan SCAN_MODE=rapid ;eddy",
    ";G1 Z5 F300;TB",
    ";G1 X0 Y0 ;TB",
    "M109 S{temp}",
    "PRINT_START EXTRUDER={temp} BED={bed_temp}",
    "G21 ;metric values",
    "G90 ;absolute positioning",
    "M82 ;set extruder to absolute mode",
    "M107 ;start with the fan off",
    "G28;Home",
    "G0 Z5 F300",
    "G1 X0 Y100 F6000",
    "G92 E0",
    "G0 Z0.5 F300",
    "G1 F1000 Y0 E15",
    "G1 F1000 X100 E25",
    "G92 E0 ;zero the extruded length again",
    "G1 F9000",
    "M117 Printing..."
  ],
  "post_gcode": [
    "M104 S0 ;extruder heater off",
    "M140 S0 ;heated bed heater off (if you have it)",
    "G91 ;relative positioning",
    "M83",
    "G1 E-1 F1200  ;retract the filament a bit before lifting the nozzle, to release some of the pressure",
    "G1 Z+1 F300 ",
    "G90 ;absolute positioning",
    "G1 X100 Y0 F6000",
    "G1 E-4 F1200",
    "M84 ;steppers off",
    "M107 ; turn off fan",
    "PRINT_END"
  ],
  "fan_gcode": "M106 S{fan_speed}  ; p3d: add for orca slicer",
  "progress_gcode": "",
  "layer_gcode": "",
  "heated_bed": true,
  "speed_travel": null
}